{
  "name": "garbo-pearls",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "repository": "https://github.com/loathers/garbage-collector.git",
  "description": "Unblemished pearl farming for garbo, ported from pearlo",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write . && eslint src --fix && prettier --write .",
    "check": "tsc",
    "lint": "eslint src && prettier --check .",
    "test": "vitest run",
    "madge": "madge --circular . ./src/index.ts",
    "pre-commit": "lint-staged"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx,json,css}": [
      "prettier --write",
      "eslint --quiet --fix",
      "prettier --write"
    ],
    "**/*.{json,md,html,yml}": [
      "prettier --write --ignore-unknown"
    ]
  },
  "peerDependencies": {
    "grimoire-kolmafia": "^0.3.35",
    "kolmafia": "^5.29376.0",
    "libram": "^0.11.40"
  },
  "devDependencies": {
    "eslint": "^9.39.2",
    "eslint-config-garbo": "workspace:^",
    "grimoire-kolmafia": "^0.3.35",
    "jiti": "^2.6.1",
    "kolmafia": "^5.29376.0",
    "libram": "^0.11.40",
    "lint-staged": "^15.2.9",
    "madge": "^8.0.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9"
  }
}
